# ══════════════════════════════════════════════════════════════════════════════
# Byapar Frontend — PRODUCTION environment
# ══════════════════════════════════════════════════════════════════════════════
# Set these in your deployment platform dashboard (Render / Netlify / Vercel).
# NEVER commit real values.

VITE_API_BASE_URL=https://erp-unified-backend.onrender.com/api/v1
VITE_FRONTEND_PORT=443
VITE_BACKEND_PORT=443

VITE_APP_NAME=Byapar
VITE_APP_ENV=production

VITE_SHOW_DEV_BADGE=false
VITE_ENABLE_API_LOGS=false

# Customer Product Ordering module — REQUIRED for the public storefront
# (Customer Register/Login/Order Entry) to work in production, unless
# every storefront link includes an explicit ?company=<uuid> parameter.
# Set the REAL company UUID (from `SELECT id, name FROM companies;`) in
# your deployment platform's dashboard — do NOT put a real value in this
# committed file. Left unset here on purpose; see .env.example for the
# full explanation. Remember: this is a Vite build-time variable, so a
# rebuild/redeploy is required after setting or changing it.
VITE_STOREFRONT_COMPANY_ID=
