# ─── Environment variables template ───────────────────────────────────────────
# Copy to .env.local and fill in your values.
# .env.local is gitignored and overrides .env.development.

VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_NAME=Byapar
VITE_APP_ENV=development
VITE_SHOW_DEV_BADGE=true
VITE_ENABLE_API_LOGS=true

# Set to true for a LAN-distributed build with no fixed backend baked in
# (pre-login "Connect to Server" / discovery / QR / manual IP + pairing).
# Leave false for a normal cloud build pointed at one fixed backend.
VITE_LAN_MODE=false

# Customer Product Ordering module: which company's catalog the public
# storefront (Customer Register/Login/Order Entry) shows. Required for
# any deployment where customers reach the storefront without a
# `?company=<uuid>` URL parameter (the normal case in production).
#
# Leave empty here — this is a real companies.id value from your
# database, not something to invent or guess. Look it up with
# `SELECT id, name FROM companies;` (or Settings → Company in the staff
# app) and set the real UUID in your deployment platform's environment
# variables (Vercel/Netlify/Render dashboard), never committed to source.
#
# This is a Vite build-time variable: after changing it in the platform
# dashboard you must trigger a fresh build/deploy, not just a restart —
# it's baked into the JS bundle at build time, not read at runtime.
#
# If left unset, Customer Register/Login will show a clear "Store
# configuration is missing" message instead of silently sending an empty
# company_id.
VITE_STOREFRONT_COMPANY_ID=
