# ─── Environment variables template ───────────────────────────────────────────
# Copy to .env.local and fill in your values.
# .env.local is gitignored and overrides .env.development.

VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_NAME=Byapar
VITE_APP_ENV=development
VITE_SHOW_DEV_BADGE=true
VITE_ENABLE_API_LOGS=true

# Set to true for a LAN-distributed build with no fixed backend baked in
# (pre-login "Connect to Server" / discovery / QR / manual IP + pairing).
# Leave false for a normal cloud build pointed at one fixed backend.
VITE_LAN_MODE=false

# Company-Owned Customer architecture: which company/store the public
# storefront (Customer Register/Login/Order Entry) shows. Every customer
# belongs to exactly one company — this is how the storefront knows which
# one, WITHOUT the customer ever seeing or entering a database UUID.
#
# Preferred: a slug (companies.storefront_code — set/edit it under
# Settings → Company, or it's auto-generated from the company name).
# Either bake it in here for a single-store deployment, or pass it per
# request as `?store=<slug>` (e.g. a QR code) for testing multiple
# tenants against one build without a rebuild.
VITE_STOREFRONT_CODE=

# Legacy/dev-only fallback — a raw companies.id (UUID), used only if
# VITE_STOREFRONT_CODE / `?store=` isn't set. The backend rejects this
# fallback in production unless an operator explicitly re-enables it
# (ALLOW_STOREFRONT_COMPANY_FALLBACK=true on the backend) — it exists for
# local development, not for production storefront links. Look it up with
# `SELECT id, name FROM companies;` (or Settings → Company in the staff
# app); never commit a real UUID here.
#
# This is a Vite build-time variable: after changing either of the two
# above in your deployment platform's dashboard, trigger a fresh
# build/deploy, not just a restart — it's baked into the JS bundle, not
# read at runtime.
#
# If neither is set, Customer Register/Login will show a clear "Store
# configuration is unavailable" message instead of silently sending an
# empty/garbage company_id.
VITE_STOREFRONT_COMPANY_ID=
